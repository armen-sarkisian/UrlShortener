<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClientAppDirectory>$(MSBuildProjectDirectory)\ClientApp</ClientAppDirectory>
    <!-- Allows skipping the frontend build: dotnet build -p:SkipClientAppBuild=true -->
    <SkipClientAppBuild Condition="'$(SkipClientAppBuild)' == ''">false</SkipClientAppBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UrlShortener.Domain\UrlShortener.Domain.csproj" />
    <ProjectReference Include="..\UrlShortener.Infrastructure\UrlShortener.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frontend sources and build output must not reach compilation or publish as content. -->
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
    <Compile Remove="ClientApp\**" />
  </ItemGroup>

  <Target Name="InstallClientAppDependencies"
          Condition="'$(SkipClientAppBuild)' != 'true' And !Exists('$(ClientAppDirectory)\node_modules')">
    <Message Importance="high" Text="Installing ClientApp dependencies..." />
    <Exec Command="npm install" WorkingDirectory="$(ClientAppDirectory)" />
  </Target>

  <Target Name="BuildClientApp"
          AfterTargets="InstallClientAppDependencies"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="InstallClientAppDependencies"
          Condition="'$(SkipClientAppBuild)' != 'true'">
    <Message Importance="high" Text="Building the Angular application into wwwroot/app..." />
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppDirectory)" />
  </Target>

</Project>
