@model AboutViewModel
@{
    ViewData["Title"] = "About";
}

<h1>How link shortening works</h1>

@if (Model.CanEdit)
{
    <form method="post" class="card form">
        <div asp-validation-summary="All" class="validation-summary"></div>

        <label asp-for="Content"></label>
        <textarea asp-for="Content" rows="18"></textarea>
        <span asp-validation-for="Content" class="field-error"></span>

        <button type="submit" class="primary">Save</button>
    </form>
}
else
{
    <article class="card about-text">@Model.Content</article>
}

<p class="hint">
    Updated @Model.UpdatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC@(Model.UpdatedBy is null ? "" : $", by {Model.UpdatedBy}")
</p>
