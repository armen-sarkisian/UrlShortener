@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>

<form method="post" class="card form">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <label asp-for="Login"></label>
    <input asp-for="Login" autocomplete="username" autofocus/>
    <span asp-validation-for="Login" class="field-error"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password" autocomplete="current-password"/>
    <span asp-validation-for="Password" class="field-error"></span>

    <label class="checkbox">
        <input asp-for="RememberMe"/>
        <span>Remember me</span>
    </label>

    <input type="hidden" asp-for="ReturnUrl"/>
    <button type="submit" class="primary">Sign in</button>
</form>

<p class="hint">
    Demo accounts: <code>admin / Admin123$</code> and <code>user / User123$</code>.
</p>
